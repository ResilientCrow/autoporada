{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // Domain, snapshot and document modules are built bottom-up, before their consumers (plan §10), so
  // each module's index.ts is a public API: its exports are not reported as
  // unused. Dead files and dead internal code are still reported.
  "entry": [
    "scripts/*.mjs",
    "scripts/*.ts",
    "src/domain/*/index.ts",
    "src/application/*/index.ts",
    "src/contracts/index.ts",
    "src/snapshot/index.ts",
    "src/document/index.ts",
    "src/notify/index.ts",
    // The Arch client (ADR 0053), bundled by arch/build-real.mjs.
    "arch/a/main.tsx",
  ],
  // System tools, not npm packages: poppler-utils for the PDF render check,
  // openssl for the test certificate (made as docs/ENTRA-SETUP.md §6 says).
  "ignoreBinaries": ["pdftotext", "pdffonts", "pdftohtml", "openssl"],
  "project": [
    "src/**/*.{ts,tsx,css}",
    "arch/**/*.{ts,tsx,mjs}",
    "scripts/**/*.{mjs,ts}",
    "test/**/*.ts",
  ],
}
