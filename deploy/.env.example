# Copy to .env (install.sh does) and fill in. Secrets never go here: they
# are files in ./secrets, which install.sh creates.

# The image tag `docker compose build` produces, e.g. the git tag being deployed
APP_VERSION=
# Public host name; DNS points here and ports 80 and 443 are open
APP_HOST=autoporada.ssps.cz
# Let's Encrypt account e-mail (certificate expiry notices)
ACME_EMAIL=
# Raise to 31536000 (a year) once the smoke test has passed
HSTS_MAX_AGE=86400

# From the Entra app registrations (docs/ENTRA-SETUP.md §1)
TENANT_ID=
# The mail registration (worker and cli) and its certificate's thumbprint as the Entra portal
# shows it (40 hex characters)
CLIENT_ID=
CERT_THUMBPRINT=
# The web registration (sign-in and directory search) and its own certificate's thumbprint
WEB_CLIENT_ID=
WEB_CERT_THUMBPRINT=
DOMAIN_HINT=ssps.cz
MAIL_FROM=autoporada@ssps.cz

# Entra object id of the first headmaster; used only while no headmaster
# exists. Empty it once the headmaster has signed in.
BOOTSTRAP_HEADMASTER_OID=

# School people search in the point editor: off (default) or graph. Keep it off until the smoke
# test (deploy/SMOKE-TEST.md step 29) shows that the tenant answers it.
DIRECTORY=off
