# The only way in (ADR 0008): TLS with Let's Encrypt, HSTS, a fresh request
# id, and the app behind it. Stock Caddy 2.11; HSTS_MAX_AGE starts at a day
# and goes to a year once the smoke test passes.

# What Entra puts in the callback URL and what the users list is searched
# for (names, e-mails), removed from every log line that carries the
# request: the access log and Caddy's own error log. The Referer would
# repeat the search, so it goes too.
(redact_query) {
	request>uri query {
		delete code
		delete state
		delete session_state
		delete error_description
		delete hledat
	}
	request>headers>Referer delete
}

{
	email {$ACME_EMAIL}
	admin off
	# An error Caddy raises itself (a 502 while web restarts) logs the
	# request too, so it is filtered like the access log below.
	log default {
		exclude http.log.error
	}
	log errors {
		include http.log.error
		format filter {
			import redact_query
		}
	}
	servers {
		# Only TCP 80 and 443 are open.
		protocols h1 h2
		timeouts {
			read_header 10s
			# A body that trickles in holds a connection (the largest, 10 MB, takes seconds).
			read_body 60s
			idle 2m
		}
	}
}

{$APP_HOST} {
	# Bodies are 1 MB, but for the annexes with pictures (the 3.5 MB annex cap and their ids,
	# arch-run.ts MAX_BODY_BYTES) and an old .doc for the annex import (10 MB, ADR 0066). One limit
	# applies to each path. The annex ones were 1 MB before ADR 0066: an annex with pictures never saved.
	@small not path /api/arch/run /api/arch/convert
	request_body @small {
		max_size 1MB
	}
	@run path /api/arch/run
	request_body @run {
		max_size 4MB
	}
	@convert path /api/arch/convert
	request_body @convert {
		max_size 10MB
	}
	# Always Caddy's own: the app trusts this header for its logs.
	request_header X-Request-Id {http.request.uuid}
	request_header -X-Middleware-Subrequest
	header {
		Strict-Transport-Security "max-age={$HSTS_MAX_AGE:86400}"
		-Server
	}
	@static path /_next/static/*
	encode @static zstd gzip
	# No trusted_proxies: X-Forwarded-For is the peer Caddy saw, which the
	# rate limits key on; Host is forwarded for the Server Actions check.
	reverse_proxy web:3000
	log {
		output stdout
		format filter {
			import redact_query
			# The sign-in redirect carries state and nonce.
			resp_headers>Location delete
		}
	}
}
