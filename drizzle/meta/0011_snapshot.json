        },
        "issues_meeting_in_week": {
          "name": "issues_meeting_in_week",
          "value": "\"issues\".\"meeting_date\" >= \"issues\".\"monday\" AND \"issues\".\"meeting_date\" < \"issues\".\"monday\" + 7"
        },
        "issues_school_year": {
          "name": "issues_school_year",
          "value": "\"issues\".\"school_year\" ~ '^\\d{4}/\\d{4}$'"
        }
      },
      "isRLSEnabled": false
    }
