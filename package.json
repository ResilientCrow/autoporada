{
  "name": "autoporada",
  "version": "0.1.0",
  "private": true,
  "description": "Generates the weekly „Porada vedení školy“ document of Smíchovská střední",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node scripts/start-standalone.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "lint:arch": "depcruise src --config .dependency-cruiser.cjs",
    "lint:palette": "node scripts/check-palette.mjs",
    "lint:unused": "knip",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:golden": "vitest run --project golden",
    "test:all": "vitest run --project unit --project integration --project golden",
    "test:e2e": "playwright test",
    "dev:services": "docker compose -f compose.dev.yaml up -d --wait",
    "dev:services:down": "docker compose -f compose.dev.yaml down",
    "facts:extract": "node scripts/extract-template-facts.ts",
    "cli": "tsx --tsconfig tsconfig.json src/cli/main.ts",
    "test:render": "vitest run --project render",
    "lint:chars": "node scripts/check-characters.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dependency-cruiser": "18.6.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "4.10.2",
    "fast-xml-parser": "^5.11.2",
    "jszip": "3.10.1",
    "knip": "^6.41.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "docx": "9.11.0",
    "next": "16.4.2",
    "pino": "10.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  }
}
