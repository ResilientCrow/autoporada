# Copy to .env for local development. Production values come from Docker
# secrets: any variable can instead be given as <NAME>_FILE=/run/secrets/...

# Deployment environment: development | test | production.
# Required whenever NODE_ENV=production (e.g. under `next start`).
APP_ENV=development

# Public origin of the app (scheme + host, no trailing slash)
APP_ORIGIN=http://localhost:3000

# PostgreSQL
DATABASE_URL=postgres://autoporada:autoporada@localhost:5432/autoporada

# OpenID Connect (dev: the mock IdP from compose.dev.yaml)
OIDC_ISSUER=http://localhost:8080/ssps
OIDC_TENANT_ID=00000000-0000-0000-0000-000000000001
OIDC_CLIENT_ID=autoporada-dev
# Dev uses a client secret against the mock IdP; production uses a certificate
# (docs/ENTRA-SETUP.md §6): the key and the certificate, both as secret files.
OIDC_CLIENT_SECRET=dev-secret
# OIDC_CLIENT_KEY_FILE=/run/secrets/entra_key
# OIDC_CLIENT_CERT_FILE=/run/secrets/entra_cert
# Optional cross-check: the thumbprint the Entra portal shows for the certificate
# OIDC_CLIENT_CERT_THUMBPRINT=
# Skips Entra's account picker for the school domain
# OIDC_DOMAIN_HINT=ssps.cz

# Microsoft Graph (people search, sendMail)
GRAPH_BASE_URL=https://graph.microsoft.com/v1.0

# Mail: "smtp" (dev, Mailpit) or "graph" (production)
MAIL_TRANSPORT=smtp
# Placeholder until IT creates the shared mailbox (docs/ENTRA-SETUP.md)
MAIL_FROM=autoporada@example.org
SMTP_URL=smtp://localhost:1025

# People search: "off" (the default; production stays off until the tenant is set up), "graph"
# (Microsoft Graph, through GRAPH_BASE_URL) or "dev" (searches a JSON file of invented people).
# The dev path must be absolute.
DIRECTORY=off
# DIRECTORY=dev
# DIRECTORY_DEV_PATH=/absolute/path/to/autoporada/docker/dev/directory.json

# Gotenberg (DOCX -> PDF), internal network only
GOTENBERG_URL=http://localhost:3001

# Entra object id of the first headmaster; used only while no headmaster exists.
# In dev: the mock IdP's "reditel" persona.
BOOTSTRAP_HEADMASTER_OID=0d000000-0000-4000-8000-000000000003

# trace | debug | info | warn | error
LOG_LEVEL=info

# How often the worker polls the queue, in seconds (0.5 to 30)
# WORKER_POLL_SECONDS=2
